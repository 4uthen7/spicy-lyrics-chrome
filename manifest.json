{
  "manifest_version": 3,
  "name": "Spicy Lyrics for Chrome",
  "short_name": "Spicy Lyrics",
  "version": "1.2.2",
  "description": "Word-by-word animated lyrics for the Spotify web player, rendered the way the Spicy Lyrics desktop extension does it.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://spclient.wg.spotify.com/*",
    "https://i.scdn.co/*",
    "https://mosaic.scdn.co/*",
    "https://lineup-images.scdn.co/*",
    "https://image-cdn-ak.spotifycdn.com/*",
    "https://image-cdn-fa.spotifycdn.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Spicy Lyrics",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "src/content/inject-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "src/shared/contract.js",
        "src/shared/store.js",
        "src/content/lyrics/color-lyrics.js",
        "src/content/lyrics/ttml.js",
        "src/content/lyrics/dom-scraper.js",
        "src/content/lyrics/sources.js",
        "src/content/player/state.js",
        "src/content/bridge.js",
        "src/content/ui/video-bg.js",
        "src/content/ui/background.js",
        "src/content/ui/lyrics-view.js",
        "src/content/ui/controls.js",
        "src/content/ui/overlay.js",
        "src/content/app.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/styles/*.css",
        "assets/*"
      ],
      "matches": [
        "https://open.spotify.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Toggle the Spicy Lyrics overlay"
    }
  }
}
